<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="es.leerchino.app"
    android:versionCode="1"
    android:versionName="1.0">
    <!-- La versión real la pone android/construir.sh a partir de git, antes
         de compilar. Los valores de aquí sólo existen para que el manifiesto
         sea válido por sí solo. -->

    <!-- Sólo hace falta red para la traducción natural con IA, que es opcional.
         Todo lo demás (diccionario, análisis, pinyin) va dentro del APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:label="Leer chino"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:hardwareAccelerated="true"
        android:allowBackup="true">

        <activity
            android:name="es.leerchino.app.MainActivity"
            android:label="Leer chino"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
